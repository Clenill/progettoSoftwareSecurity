
FROM node:26.4-alpine3.23
WORKDIR /usr/blockchain
COPY blockchain/*.json .
RUN npm install
ARG RUN_TESTS
RUN apk add --no-cache netcat-openbsd python3 py3-pip curl && \
    if [ -n "$RUN_TESTS" ]; then \
        pip3 install --no-cache-dir slither-analyzer solc-select && \
        solc-select install 0.8.28 && solc-select use 0.8.28; \
    fi
COPY blockchain/hardhat.config.ts .
COPY blockchain/scripts/ ./scripts/
COPY blockchain/ignition/modules ./ignition/modules/
COPY blockchain/contracts/ ./contracts/

